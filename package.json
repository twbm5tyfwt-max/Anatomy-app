{
  "name": "forma-anatomy",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/prepare-notices.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "node tests/smoke.mjs && node tests/three.mjs && node tests/learning.mjs && node tests/games-interaction.mjs && node tests/upgrades.mjs",
    "export:preview": "node scripts/export-preview.mjs",
    "test:3d": "node tests/three.mjs",
    "build:models": "node --max-old-space-size=6144 scripts/build-z-anatomy.mjs",
    "test:learning": "node tests/learning.mjs && node tests/games-interaction.mjs",
    "test:upgrades": "node tests/upgrades.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.4.449",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^6.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "meshoptimizer": "^1.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
